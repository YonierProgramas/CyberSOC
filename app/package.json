{
  "name": "cybersoc-defender",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite build --mode development && electron .",
    "build": "electron-vite build",
    "runtime:prepare": "powershell.exe -NoProfile -NonInteractive -File scripts/packaging/prepare-runtime.ps1",
    "package:dir": "npm run build && electron-builder --config electron-builder.json --win --x64 --dir --publish never",
    "package:smoke": "node scripts/packaging/smoke.mjs",
    "test:packaging": "node --test scripts/packaging/paths.test.mjs scripts/packaging/notices.test.mjs",
    "test:packaging:startup": "node --test scripts/packaging/startup.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:sqlite:dev": "node tests/sqlite-dev-smoke.mjs",
    "ai:smoke": "node --experimental-strip-types scripts/ai-smoke.ts",
    "ai:eval": "node --experimental-transform-types --import ./tests/ai-eval/register.mjs scripts/ai-eval.ts",
    "calibrate": "node --experimental-transform-types --import ./tests/ai-eval/register.mjs scripts/calibrate.ts",
    "bench:queue": "node --experimental-strip-types scripts/benchmark-queue.ts",
    "perf:scan": "node --experimental-strip-types scripts/perf-scan.ts",
    "evidence:capture": "electron-vite build --mode development && node --experimental-strip-types scripts/capture-evidence.ts",
    "test:e2e": "electron-vite build --mode development && playwright test",
    "package:nsis": "npm run build && electron-builder --config electron-builder.json --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "description": "Análisis local de archivos y evidencias de CyberSOC Defender",
  "author": "Equipo CyberSOC Defender"
}
